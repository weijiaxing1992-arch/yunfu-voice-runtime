+// TestBenchmarkFailureFinalContextOutcome直接调用真实defer的归一函数，避免只预置任务失败而漏验取消覆盖。
+func TestBenchmarkFailureFinalContextOutcome(t *testing.T) {
+	original := errors.New("原始发生器或报告验收失败")
+	for _, tc := range []struct {
+		name, status, wantStatus, wantMessage string
+		runErr, parentErr, deadlineErr        error
+		preserve, sameError                   bool
+	}{
+		{"failed_then_cancel", "failed", "failed", original.Error(), original, context.Canceled, context.Canceled, true, true},
+		{"failed_then_deadline", "failed", "failed", original.Error(), original, nil, context.DeadlineExceeded, true, true},
+		{"failed_then_both", "failed", "failed", original.Error(), original, context.Canceled, context.DeadlineExceeded, true, true},
+		{"failed_no_cancel", "failed", "failed", original.Error(), original, nil, nil, true, true},
+		{"success_then_cancel", "completed", "stopped", "测试已停止", nil, context.Canceled, context.Canceled, false, false},
+		{"success_then_deadline", "completed", "failed", "测试超过 120 秒总期限", nil, nil, context.DeadlineExceeded, false, false},
+		{"unconfirmed_then_cancel", "failed", "stopped", "测试已停止", original, context.Canceled, context.Canceled, false, false},
+		{"success_without_cancel", "completed", "completed", "", nil, nil, nil, false, false},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			status, err := benchmarkContextOutcome(tc.status, tc.runErr, tc.parentErr, tc.deadlineErr, tc.preserve, 120)
+			message := ""
+			if err != nil {
+				message = err.Error()
+			}
+			if status != tc.wantStatus || message != tc.wantMessage || tc.sameError && err != original {
+				t.Fatalf("终态或原始错误身份被覆盖: status=%s error=%v", status, err)
+			}
+		})
+	}
+}
