+			go func() { defer workers.Done(); <-start; seen <- h.LifetimeDone() }()
+		}
+		workers.Add(3)
+		go func() { defer workers.Done(); <-start; h.retire() }()
+		go func() { defer workers.Done(); <-start; h.bind(sub) }()
+		go func() { defer workers.Done(); <-start; h.revoke(); cancel() }()
+		close(start)
+		workers.Wait()
+		close(seen)
+		for done := range seen {
