+// validRXDiscardMetadata只允许实际Rust生产的拒收/迟到矩阵，不给任意kind增加丢弃计数。
+// ObservationFailed的8/9终态继承原观察事实，但其正文在decodeRXFrame中仍必须为空。
+func validRXDiscardMetadata(f RXFrame) bool {
+	if f.DiscardedPackets == 0 {
+		return true
+	}
+	if f.Kind == RXSourceBoundary {
+		return (f.Boundary == 2 || f.Boundary == 3 || f.Boundary == 4 || f.Boundary == 6) && f.Reason == 0 && f.KnownDurationTicks == 0 && !f.CNApplied
+	}
+	if f.Kind == RXObservationFailed && (f.Reason == 8 || f.Reason == 9) {
+		return validRXInheritedFailure(f)
+	}
+	if f.DiscardedPackets != 1 || f.CNApplied {
+		return false
+	}
+	if f.Kind == RXLocalExpired {
+		return (f.Reason == 10 || f.Reason == 11) && f.KnownDurationTicks == 160
+	}
+	return f.Kind == RXAuxiliaryExpired && f.Reason == 10 && f.KnownDurationTicks == 0
+}
+
+// 终态只可继承同一真实观察的字段组合，不能混合CN生效、音频长度和源清队列数量。
+func validRXInheritedFailure(f RXFrame) bool {
+	if f.CNApplied {
+		return f.Boundary == 0 && f.KnownDurationTicks == 0 && f.DiscardedPackets == 0
+	}
+	if f.Boundary == 5 {
+		return f.KnownDurationTicks == 160 && f.DiscardedPackets == 0
+	}
+	if f.Boundary != 0 {
+		if f.KnownDurationTicks != 0 {
+			return false
+		}
+		return f.Boundary != 1 || f.DiscardedPackets == 0
+	}
+	if f.DiscardedPackets != 0 {
+		return f.DiscardedPackets == 1 && (f.KnownDurationTicks == 0 || f.KnownDurationTicks == 160)
+	}
+	return true
+}
