+			if json.Unmarshal(m.body, &done) != nil || done != finish {
+				t.Fatal("DONE没有精确回显实际前缀")
+			}
+			doneCount++
+		}
+	}
+	if doneCount != 1 {
+		t.Fatal("实际线缆缺少唯一DONE")
+	}
+	partial, final := 0, 0
+	for _, event := range events {
+		if event.Type != "partial" && event.Type != "final" {
