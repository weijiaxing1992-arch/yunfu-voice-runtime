+package resample
+
+// coefficients 是 Rust audio/branch.rs 的固定 127 抽头、Hamming 窗低通系数。
+// 8→16kHz：截止频率 0.225，直流归一化；十六进制字面量保持原 f64 位值。
+// 系数按索引顺序编码为 little-endian f64 的 SHA-256：e7d108779e82bc025af440ac3f2fbf4434972f93298b4bdfc79c56dc50795f01。
+// 生成命令、原文件指纹及独立 Rust 样本见 testdata/README.md。
+var coefficients = [127]float64{
+	0x1.7996c8d63a8fcp-12,
+	-0x1.0c092b933bd22p-13,
+	-0x1.bca2b6a33af5bp-12,
+	0x1.c92355fbabda4p-59,
+	0x1.f1e465b66f836p-12,
