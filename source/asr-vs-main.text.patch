+		}
+	}
+	if len(audio) != wantFrames || finishCount != 1 || finish.Token != token || finish.Frames != strconv.Itoa(wantFrames) || finish.Samples != strconv.Itoa(wantFrames*int(rate/50)) || finish.Markers != strconv.Itoa(markerCount) {
