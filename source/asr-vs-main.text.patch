+type asrSIPPrefix struct {
+	Token   string `json:"stream_token"`
+	Last    string `json:"last_event_seq"`
+	Frames  string `json:"audio_frames"`
+	Samples string `json:"samples"`
+	Markers string `json:"markers"`
+}
