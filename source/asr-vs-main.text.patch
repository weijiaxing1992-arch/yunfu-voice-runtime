+				t.Fatal("并发生命期信号发生替换")
+			}
+			expectRXLifetime(t, done, true)
+		}
+		select {
+		case <-sub.revoked:
+		default:
+			t.Fatal("退休竞态遗留可读绑定")
+		}
+	}
+}
