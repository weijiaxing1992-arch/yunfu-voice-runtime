+	r = layerResult(2, 2, 1, 4, 4, 2*frameDurationNS, 3*frameDurationNS)
+	r.Type = "final"
+	if _, _, err := q.result(r); err != nil {
+		t.Fatal(err)
+	}
+	if q.count != 0 || q.spans != [provenanceLimit]audioSpan{} {
+		t.Fatal("完成后仍保留历史证明")
+	}
